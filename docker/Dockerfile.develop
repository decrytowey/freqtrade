# Use the official freqtrade image as the base image
FROM freqtradeorg/freqtrade:develop

# Switch to root to install system dependencies
USER root

# Install system dependencies required for building TA-Lib and other dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    curl \
    libtool \
    libffi-dev \
    libssl-dev \
    python3-dev \
    gcc \
    make \
    libzmq3-dev \
    libcurl4-openssl-dev \
    libpq-dev \
    libjpeg-dev \
    libjpeg8-dev \
    liblcms2-dev \
    libblas-dev \
    liblapack-dev \
    libatlas-base-dev \
    libboost-all-dev \
    && apt-get clean

# Install TA-Lib from source
RUN wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz && \
    tar -xvzf ta-lib-0.4.0-src.tar.gz && \
    cd ta-lib && \
    ./configure && \
    make && \
    make install && \
    cd .. && \
    rm -rf ta-lib ta-lib-0.4.0-src.tar.gz

# Install Poetry for dependency management (if you're using Poetry)
RUN pip install poetry

# Set the working directory
WORKDIR /app

# Copy your application files
COPY . .

# Install Python dependencies using Poetry or pip
RUN poetry install  # Or use pip install -r requirements.txt if you're using pip

# Expose the port the app will run on
EXPOSE 8080

# Set the entry point for the container (if different from the default)
CMD ["freqtrade", "trade", "--config", "user_data/config.json"]
