# Use a base image with Python
FROM python:3.11-slim

# Set the working directory in the container
WORKDIR /app

# Install system dependencies and TA-Lib
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    wget \
    tar \
    && wget https://github.com/ta-lib/ta-lib/releases/download/0.4.0/ta-lib-0.4.0-src.tar.gz && \
    tar -xvzf ta-lib-0.4.0-src.tar.gz && \
    cd ta-lib && \
    ./configure && \
    make && \
    make install && \
    cd .. && \
    rm -rf ta-lib ta-lib-0.4.0-src.tar.gz

# Install poetry (optional, based on your project setup)
RUN pip install poetry

# Copy the project files into the container
COPY . .

# Install the project dependencies using poetry (or pip, depending on your setup)
RUN poetry install --no-dev  # If using poetry
# Alternatively, use pip if you are not using poetry
# RUN pip install -r requirements.txt

# Expose the port the app runs on (if needed)
EXPOSE 8080

# Define the command to run the application
CMD ["python", "your_main_script.py"]  # Replace with your actual entry point script

