# Use an official Python runtime as a parent image
FROM python:3.11-slim

# Set environment variables to prevent writing .pyc files and buffer output
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

# Set the working directory inside the container
WORKDIR /app

# Install system dependencies for TA-Lib
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    make \
    libatlas-base-dev \
    ta-lib

# Install Poetry (or any other dependency manager you use)
RUN curl -sSL https://install.python-poetry.org | python3 -

# Add Poetry to PATH
ENV PATH="/root/.local/bin:$PATH"

# Copy the current directory contents into the container at /app
COPY . /app/

# Install Python dependencies
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# Expose the port your app will run on (if applicable)
EXPOSE 8080

# Command to run your application (this should be modified based on your bot setup)
CMD ["python", "your_script.py"]

