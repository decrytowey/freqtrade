# Use the official Python image as the base image
FROM freqtradeorg/freqtrade:develop

# Install system dependencies required for TA-Lib and other packages
USER root
RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    curl \
    libtool \
    libffi-dev \
    libssl-dev \
    python3-dev \
    libta-lib0-dev && \
    apt-get clean

# Install Poetry for dependency management (if you're using Poetry)
RUN pip install poetry

# Set the working directory
WORKDIR /app

# Copy your application files
COPY . .

# Install Python dependencies using Poetry or pip
RUN poetry install  # Or use pip install if you're using pip

# Expose the port the app will run on
EXPOSE 8080

# Set the entry point for the container (if different from the default)
CMD ["freqtrade", "trade", "--config", "user_data/config.json"]

